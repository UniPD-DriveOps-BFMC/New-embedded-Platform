 542:Core/Src/freertos.cpp **** void speed(float vel){
 543:Core/Src/freertos.cpp **** 	// ---------- SPEED references ----------
 544:Core/Src/freertos.cpp **** 	if(vel > MAX_FORWARD_SPEED){
 545:Core/Src/freertos.cpp **** 		speedTarget = MAX_FORWARD_SPEED;
 546:Core/Src/freertos.cpp **** 	}
