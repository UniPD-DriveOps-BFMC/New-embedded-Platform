 571:Core/Src/freertos.cpp **** void drive_pwm(float pwm_value){
 572:Core/Src/freertos.cpp **** 	// ---------- ACTUATION - SPEED ----------
 573:Core/Src/freertos.cpp **** 
 574:Core/Src/freertos.cpp **** 	// is on reverse
 575:Core/Src/freertos.cpp **** 	pwm_value = -pwm_value;
 576:Core/Src/freertos.cpp **** 
 577:Core/Src/freertos.cpp **** 	// Range pwm_value - values are calibrated to reach a max of 1.0 m/s forward and 0.5 backwards
 578:Core/Src/freertos.cpp **** 	if (pwm_value > 0.009f) pwm_value = 0.009f; 	//Backwards
 579:Core/Src/freertos.cpp **** 	if (pwm_value < -0.0119f) pwm_value = -0.0119f; //Forward
 580:Core/Src/freertos.cpp **** 
 581:Core/Src/freertos.cpp **** 	// considering the default zero speed is at 7.5568% duty cycle
 582:Core/Src/freertos.cpp **** 	float duty_cycle = (pwm_value + MOTOR_SPEED_OFFSET);
 583:Core/Src/freertos.cpp **** 
 584:Core/Src/freertos.cpp **** 	// Convert duty cycle to pulse width and set the PWM value
 585:Core/Src/freertos.cpp **** 	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_3, (uint32_t)(duty_cycle * MOT_PWM_COUNT_MAX));
 586:Core/Src/freertos.cpp **** }
