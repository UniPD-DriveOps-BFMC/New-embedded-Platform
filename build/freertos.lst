 524:Core/Src/freertos.cpp **** void speed(float vel){
 525:Core/Src/freertos.cpp **** 	// ---------- SPEED references ----------
 526:Core/Src/freertos.cpp **** 	if(vel > MAX_FORWARD_SPEED){
 527:Core/Src/freertos.cpp **** 		speedTarget = MAX_FORWARD_SPEED;
 528:Core/Src/freertos.cpp **** 	}
 529:Core/Src/freertos.cpp **** 	else if (vel < MAX_BACKWARD_SPEED){
 530:Core/Src/freertos.cpp **** 		speedTarget = MAX_BACKWARD_SPEED;
