 536:Core/Src/freertos.cpp **** 	// ---------- STATE ----------
 537:Core/Src/freertos.cpp **** 	isSpeedControl 		= true;
 538:Core/Src/freertos.cpp **** 	isPositionControl 	= false;
 539:Core/Src/freertos.cpp **** 
 540:Core/Src/freertos.cpp **** }
