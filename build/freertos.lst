 566:Core/Src/freertos.cpp **** void drive_pwm(float pwm_value){
 567:Core/Src/freertos.cpp **** 	// ---------- ACTUATION - SPEED ----------
 568:Core/Src/freertos.cpp **** 
 569:Core/Src/freertos.cpp **** 	// is on reverse
 570:Core/Src/freertos.cpp **** 	pwm_value = -pwm_value;
 571:Core/Src/freertos.cpp **** 
 572:Core/Src/freertos.cpp **** 	// Range pwm_value - values are calibrated to reach a max of 1.0 m/s forward and 0.5 backwards
 573:Core/Src/freertos.cpp **** 	if (pwm_value > 0.009f) pwm_value = 0.009f; 	//Backwards
 574:Core/Src/freertos.cpp **** 	if (pwm_value < -0.0119f) pwm_value = -0.0119f; //Forward
 575:Core/Src/freertos.cpp **** 
 576:Core/Src/freertos.cpp **** 	// considering the default zero speed is at 7.5568% duty cycle
 577:Core/Src/freertos.cpp **** 	float duty_cycle = (pwm_value + MOTOR_SPEED_OFFSET);
 578:Core/Src/freertos.cpp **** 
