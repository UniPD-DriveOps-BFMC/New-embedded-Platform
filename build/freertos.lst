 542:Core/Src/freertos.cpp **** void steer(float angle){
 543:Core/Src/freertos.cpp **** 
 544:Core/Src/freertos.cpp **** 	// ---------- STEER references ----------
 545:Core/Src/freertos.cpp **** 	if(angle > MAX_STEERING_ANGLE){steerRef = MAX_STEERING_ANGLE;}
 546:Core/Src/freertos.cpp **** 	else if (angle < -MAX_STEERING_ANGLE){steerRef = -MAX_STEERING_ANGLE;}
 547:Core/Src/freertos.cpp **** 	else{steerRef = angle;}
 548:Core/Src/freertos.cpp **** 
 549:Core/Src/freertos.cpp **** 	// ---------- STEER ----------
 550:Core/Src/freertos.cpp **** 	servoPWM = STEER_DEG2PWM_RATIO * steerRef + STEER_DEG2PWM_OFFSET;			// [deg] -> [pwm]
 551:Core/Src/freertos.cpp **** 	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, servoPWM*SERVO_PWM_COUNT_MAX);	// set servo pwm
 552:Core/Src/freertos.cpp **** }
