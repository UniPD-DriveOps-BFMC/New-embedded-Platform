 225:Core/Src/tof.c **** 
 226:Core/Src/tof.c **** static HAL_StatusTypeDef VL6180X_PololuInit(uint8_t dev7)
 227:Core/Src/tof.c **** {
 228:Core/Src/tof.c ****     uint8_t fresh = 0;
 229:Core/Src/tof.c ****     if (readReg(dev7, SYSTEM__FRESH_OUT_OF_RESET, &fresh) != HAL_OK)
 230:Core/Src/tof.c ****         return HAL_ERROR;
 231:Core/Src/tof.c **** 
 232:Core/Src/tof.c ****     if (fresh != 1) return HAL_OK;
 233:Core/Src/tof.c **** 
 234:Core/Src/tof.c ****     /* Mandatory: private registers (AN4545 SR03 settings, copied from
 235:Core/Src/tof.c ****      * Pololu's library). */
 236:Core/Src/tof.c ****     static const struct { uint16_t reg; uint8_t val; } seq[] =
 237:Core/Src/tof.c ****     {
 238:Core/Src/tof.c ****         {0x207, 0x01}, {0x208, 0x01}, {0x096, 0x00}, {0x097, 0xFD},
 239:Core/Src/tof.c ****         {0x0E3, 0x01}, {0x0E4, 0x03}, {0x0E5, 0x02}, {0x0E6, 0x01},
 240:Core/Src/tof.c ****         {0x0E7, 0x03}, {0x0F5, 0x02}, {0x0D9, 0x05}, {0x0DB, 0xCE},
ARM GAS  /tmp/ccwdALXY.s 			page 12


 241:Core/Src/tof.c ****         {0x0DC, 0x03}, {0x0DD, 0xF8}, {0x09F, 0x00}, {0x0A3, 0x3C},
 242:Core/Src/tof.c ****         {0x0B7, 0x00}, {0x0BB, 0x3C}, {0x0B2, 0x09}, {0x0CA, 0x09},
 243:Core/Src/tof.c ****         {0x198, 0x01}, {0x1B0, 0x17}, {0x1AD, 0x00}, {0x0FF, 0x05},
 244:Core/Src/tof.c ****         {0x100, 0x05}, {0x199, 0x05}, {0x1A6, 0x1B}, {0x1AC, 0x3E},
 245:Core/Src/tof.c ****         {0x1A7, 0x1F}, {0x030, 0x00}
 246:Core/Src/tof.c ****     };
 247:Core/Src/tof.c **** 
 248:Core/Src/tof.c ****     for (uint16_t k = 0; k < sizeof(seq)/sizeof(seq[0]); k++)
 249:Core/Src/tof.c ****     {
 250:Core/Src/tof.c ****         if (writeReg(dev7, seq[k].reg, seq[k].val) != HAL_OK)
 251:Core/Src/tof.c ****             return HAL_ERROR;
 252:Core/Src/tof.c ****     }
 253:Core/Src/tof.c **** 
 254:Core/Src/tof.c ****     if (writeReg(dev7, SYSTEM__FRESH_OUT_OF_RESET, 0x00) != HAL_OK)
 255:Core/Src/tof.c ****         return HAL_ERROR;
 256:Core/Src/tof.c **** 
 257:Core/Src/tof.c ****     return HAL_OK;
 258:Core/Src/tof.c **** }
