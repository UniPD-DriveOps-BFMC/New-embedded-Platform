 166:Core/Src/tof.c **** static HAL_StatusTypeDef writeReg16(uint8_t dev7, uint16_t reg, uint16_t value)
 167:Core/Src/tof.c **** {
 168:Core/Src/tof.c ****     uint8_t buf[4];
 169:Core/Src/tof.c ****     buf[0] = (uint8_t)(reg >> 8);
 170:Core/Src/tof.c ****     buf[1] = (uint8_t)(reg & 0xFF);
 171:Core/Src/tof.c ****     buf[2] = (uint8_t)(value >> 8);
 172:Core/Src/tof.c ****     buf[3] = (uint8_t)(value & 0xFF);
 173:Core/Src/tof.c ****     HAL_StatusTypeDef st = HAL_I2C_Master_Transmit(&hi2c1, ADDR8(dev7),
 174:Core/Src/tof.c ****                                                    buf, 4, TOF_I2C_TIMEOUT_MS);
 175:Core/Src/tof.c ****     if (st != HAL_OK) TOF_I2C_Recover();
 176:Core/Src/tof.c ****     return st;
 177:Core/Src/tof.c **** }
 178:Core/Src/tof.c **** 
 179:Core/Src/tof.c **** static HAL_StatusTypeDef readReg(uint8_t dev7, uint16_t reg, uint8_t *value)
 180:Core/Src/tof.c **** {
 181:Core/Src/tof.c ****     uint8_t buf[2];
 182:Core/Src/tof.c ****     buf[0] = (uint8_t)(reg >> 8);
 183:Core/Src/tof.c ****     buf[1] = (uint8_t)(reg & 0xFF);
 184:Core/Src/tof.c ****     if (HAL_I2C_Master_Transmit(&hi2c1, ADDR8(dev7), buf, 2,
 185:Core/Src/tof.c ****                                 TOF_I2C_TIMEOUT_MS) != HAL_OK)
 186:Core/Src/tof.c ****     {
 187:Core/Src/tof.c ****         TOF_I2C_Recover();
 188:Core/Src/tof.c ****         return HAL_ERROR;
 189:Core/Src/tof.c ****     }
 190:Core/Src/tof.c ****     HAL_StatusTypeDef st = HAL_I2C_Master_Receive(&hi2c1, ADDR8(dev7),
 191:Core/Src/tof.c ****                                                   value, 1, TOF_I2C_TIMEOUT_MS);
 192:Core/Src/tof.c ****     if (st != HAL_OK) TOF_I2C_Recover();
 193:Core/Src/tof.c ****     return st;
 194:Core/Src/tof.c **** }
