 131:Core/Src/tof.c **** uint8_t TOF_GetAddressMask(void)
 132:Core/Src/tof.c **** {
 133:Core/Src/tof.c ****     uint8_t m = 0;
 134:Core/Src/tof.c ****     if (TOF_AddressReady(ADDR8(0x29))) m |= (1U << 0);
 135:Core/Src/tof.c ****     if (TOF_AddressReady(ADDR8(0x2A))) m |= (1U << 1);
 136:Core/Src/tof.c ****     if (TOF_AddressReady(ADDR8(0x3A))) m |= (1U << 2);
 137:Core/Src/tof.c ****     if (TOF_AddressReady(ADDR8(0x4A))) m |= (1U << 3);
 138:Core/Src/tof.c ****     if (TOF_AddressReady(ADDR8(0x5A))) m |= (1U << 4);
 139:Core/Src/tof.c ****     return m;
 140:Core/Src/tof.c **** }
 141:Core/Src/tof.c **** 
 142:Core/Src/tof.c **** static void TOF_I2C_Recover(void)
 143:Core/Src/tof.c **** {
 144:Core/Src/tof.c ****     if (hi2c1.State != HAL_I2C_STATE_READY ||
 145:Core/Src/tof.c ****         hi2c1.ErrorCode != HAL_I2C_ERROR_NONE)
 146:Core/Src/tof.c ****     {
 147:Core/Src/tof.c ****         HAL_I2C_DeInit(&hi2c1);
 148:Core/Src/tof.c ****         HAL_Delay(2);
 149:Core/Src/tof.c ****         HAL_I2C_Init(&hi2c1);
 150:Core/Src/tof.c ****         __HAL_I2C_ENABLE(&hi2c1);
 151:Core/Src/tof.c ****     }
 152:Core/Src/tof.c **** }
 153:Core/Src/tof.c **** 
 154:Core/Src/tof.c **** static HAL_StatusTypeDef writeReg(uint8_t dev7, uint16_t reg, uint8_t value)
 155:Core/Src/tof.c **** {
 156:Core/Src/tof.c ****     uint8_t buf[3];
 157:Core/Src/tof.c ****     buf[0] = (uint8_t)(reg >> 8);
 158:Core/Src/tof.c ****     buf[1] = (uint8_t)(reg & 0xFF);
 159:Core/Src/tof.c ****     buf[2] = value;
 160:Core/Src/tof.c ****     HAL_StatusTypeDef st = HAL_I2C_Master_Transmit(&hi2c1, ADDR8(dev7),
 161:Core/Src/tof.c ****                                                    buf, 3, TOF_I2C_TIMEOUT_MS);
 162:Core/Src/tof.c ****     if (st != HAL_OK) TOF_I2C_Recover();
 163:Core/Src/tof.c ****     return st;
ARM GAS  /tmp/ccwdALXY.s 			page 5


 164:Core/Src/tof.c **** }
