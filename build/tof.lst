 261:Core/Src/tof.c **** /* Pololu configureDefault() port                                      */
 262:Core/Src/tof.c **** /* ------------------------------------------------------------------ */
 263:Core/Src/tof.c **** 
 264:Core/Src/tof.c **** static HAL_StatusTypeDef VL6180X_PololuConfigureDefault(uint8_t dev7)
 265:Core/Src/tof.c **** {
 266:Core/Src/tof.c ****     /* AN4545 Section 9 "Recommended public registers":
 267:Core/Src/tof.c ****      * {0x0011} = 0x10 enables polling for 'New Sample ready' when
 268:Core/Src/tof.c ****      * measurement completes. Pololu's library omits this; AN4545 Rev 2
 269:Core/Src/tof.c ****      * lists it explicitly. Adding it for AN4545 compliance. */
 270:Core/Src/tof.c ****     if (writeReg  (dev7, 0x0011,                            0x10)   != HAL_OK) return HAL_ERROR;
 271:Core/Src/tof.c **** 
 272:Core/Src/tof.c ****     if (writeReg  (dev7, READOUT__AVERAGING_SAMPLE_PERIOD,  0x30)   != HAL_OK) return HAL_ERROR;
 273:Core/Src/tof.c ****     if (writeReg  (dev7, SYSALS__ANALOGUE_GAIN,             0x46)   != HAL_OK) return HAL_ERROR;
 274:Core/Src/tof.c ****     if (writeReg  (dev7, SYSRANGE__VHV_REPEAT_RATE,         0xFF)   != HAL_OK) return HAL_ERROR;
 275:Core/Src/tof.c ****     if (writeReg16(dev7, SYSALS__INTEGRATION_PERIOD,        0x0063) != HAL_OK) return HAL_ERROR;
 276:Core/Src/tof.c ****     if (writeReg  (dev7, SYSRANGE__VHV_RECALIBRATE,         0x01)   != HAL_OK) return HAL_ERROR;
 277:Core/Src/tof.c **** 
 278:Core/Src/tof.c ****     if (writeReg  (dev7, SYSRANGE__INTERMEASUREMENT_PERIOD, 0x09)   != HAL_OK) return HAL_ERROR;
 279:Core/Src/tof.c ****     if (writeReg  (dev7, SYSALS__INTERMEASUREMENT_PERIOD,   0x31)   != HAL_OK) return HAL_ERROR;
 280:Core/Src/tof.c ****     if (writeReg  (dev7, SYSTEM__INTERRUPT_CONFIG_GPIO,     0x24)   != HAL_OK) return HAL_ERROR;
 281:Core/Src/tof.c **** 
 282:Core/Src/tof.c ****     if (writeReg  (dev7, SYSRANGE__MAX_CONVERGENCE_TIME,    0x31)   != HAL_OK) return HAL_ERROR;
 283:Core/Src/tof.c ****     if (writeReg  (dev7, INTERLEAVED_MODE__ENABLE,          0x00)   != HAL_OK) return HAL_ERROR;
 284:Core/Src/tof.c **** 
 285:Core/Src/tof.c ****     return HAL_OK;
 286:Core/Src/tof.c **** }
