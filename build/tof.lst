   1:Core/Src/tof.c **** /*
   2:Core/Src/tof.c ****  * tof.c
   3:Core/Src/tof.c ****  *
   4:Core/Src/tof.c ****  * VL6180X driver for STM32 HAL, multi-sensor (4 sensors on one bus,
   5:Core/Src/tof.c ****  * disambiguated via XSHUT and unique I2C addresses).
   6:Core/Src/tof.c ****  *
   7:Core/Src/tof.c ****  * Init policy: best-effort per sensor. A failure on one sensor does
   8:Core/Src/tof.c ****  * NOT abort the others. TOF_Init() returns the bitmask of sensors
   9:Core/Src/tof.c ****  * that initialized successfully.
  10:Core/Src/tof.c ****  *
  11:Core/Src/tof.c ****  * Implementation derived from the Pololu VL6180X Arduino library
  12:Core/Src/tof.c ****  * (https://github.com/pololu/vl6180x-arduino), translated to C and
  13:Core/Src/tof.c ****  * adapted for STM32 HAL. Init / configureDefault / read sequences
  14:Core/Src/tof.c ****  * follow the same registers and values as Pololu's library, which in
  15:Core/Src/tof.c ****  * turn follows ST application note AN4545.
  16:Core/Src/tof.c ****  */
  17:Core/Src/tof.c **** 
  18:Core/Src/tof.c **** #include "tof.h"
  19:Core/Src/tof.c **** #include "i2c.h"
  20:Core/Src/tof.c **** 
  21:Core/Src/tof.c **** /* ------------------------------------------------------------------ */
  22:Core/Src/tof.c **** /* Addresses                                                           */
  23:Core/Src/tof.c **** /* ------------------------------------------------------------------ */
  24:Core/Src/tof.c **** 
  25:Core/Src/tof.c **** #define VL6180X_DEFAULT_7BIT   0x29
  26:Core/Src/tof.c **** 
  27:Core/Src/tof.c **** #define TOF1_7BIT  0x2A
  28:Core/Src/tof.c **** #define TOF2_7BIT  0x3A
  29:Core/Src/tof.c **** #define TOF3_7BIT  0x4A
  30:Core/Src/tof.c **** #define TOF4_7BIT  0x5A
ARM GAS  /tmp/ccwdALXY.s 			page 2


  31:Core/Src/tof.c **** 
