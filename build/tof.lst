  47:Core/Src/tof.c **** #define SYSRANGE__VHV_REPEAT_RATE             0x031
  48:Core/Src/tof.c **** 
  49:Core/Src/tof.c **** #define SYSALS__INTERMEASUREMENT_PERIOD       0x03E
  50:Core/Src/tof.c **** #define SYSALS__ANALOGUE_GAIN                 0x03F
  51:Core/Src/tof.c **** #define SYSALS__INTEGRATION_PERIOD            0x040
  52:Core/Src/tof.c **** 
  53:Core/Src/tof.c **** #define RESULT__RANGE_STATUS                  0x04D
  54:Core/Src/tof.c **** #define RESULT__INTERRUPT_STATUS_GPIO         0x04F
  55:Core/Src/tof.c **** #define RESULT__RANGE_VAL                     0x062
  56:Core/Src/tof.c **** 
